COMPOSE_PROJECT_NAME=society

# ─── Shared platform (must match the values the root .env* was started with) ──
POSTGRES_DB=society_events

# ─── registration-service's own DB role — see DB_ISOLATION_PLAN.md ──
REGISTRATION_DB_USER=registration_role
REGISTRATION_DB_PASSWORD=your_registration_db_password

# ─── Keycloak ─────────────────────────────────────────────────────────────
KEYCLOAK_URL=https://auth.gm-global-techies-town.club
KEYCLOAK_PUBLIC_URL=https://auth.gm-global-techies-town.club

# ─── Inter-service auth ───────────────────────────────────────────────────
INTERNAL_API_KEY=your_internal_api_key

# ─── Service-specific ─────────────────────────────────────────────────────
APP_PUBLIC_URL=your_app_public_url
SPLUNK_HEC_TOKEN=your_splunk_hec_token
AUTH_SERVICE_API_KEY=your_auth_service_api_key
SOCIETY_UPI_ID=
SOCIETY_UPI_NAME=
SOCIETY_BANK_NAME=
SOCIETY_BANK_ACCOUNT=
SOCIETY_BANK_IFSC=
SOCIETY_BANK_BENEFICIARY=
GMAIL_SMTP_USER=your_gmail_smtp_user
GMAIL_APP_PASSWORD=your_gmail_app_password

# ─── MinIO (shared object storage — must match the root stack's values) ──
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
