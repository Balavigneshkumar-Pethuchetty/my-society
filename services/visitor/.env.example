# ─── Visitor Service Configuration (.env.example template) ────────────────────
COMPOSE_PROJECT_NAME=society

# ─── Database Access (Dedicated PostgreSQL Instance) ──────────────────────────
# visitor-service has its own dedicated Postgres container and database
VISITOR_POSTGRES_HOST=visitor_postgres
VISITOR_POSTGRES_PORT=5432
VISITOR_POSTGRES_USER=visitor_service
VISITOR_POSTGRES_PASSWORD=your_visitor_postgres_password
VISITOR_POSTGRES_DB=visitor_service

# ─── Authentication (Keycloak JWT validation) ────────────────────────────────
KEYCLOAK_URL=https://auth.gm-global-techies-town.club
KEYCLOAK_PUBLIC_URL=https://auth.gm-global-techies-town.club

# ─── Inter-service Communication ───────────────────────────────────────────────
INTERNAL_API_KEY=your_internal_api_key
NOTIFICATION_SERVICE_URL=http://notification-service:3009

# ─── Auth Service Integration ─────────────────────────────────────────────────
AUTH_SERVICE_API_KEY=your_auth_service_api_key

# ─── Society Configuration ────────────────────────────────────────────────────
SOCIETY_NAME=your_society_name
SOCIETY_SHORT_NAME=your_society_short_name
SOCIETY_CITY=your_society_city

# ─── MinIO (object storage) ────────────────────────────────────────────────────
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password

# ─── Monitoring ───────────────────────────────────────────────────────────────
SPLUNK_HEC_TOKEN=your_splunk_hec_token
