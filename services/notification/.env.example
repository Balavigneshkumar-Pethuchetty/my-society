# Environment
ENVIRONMENT=development
DEBUG=true
SERVICE_PORT=3008

# Database Configuration
DB_HOST=pgbouncer
DB_PORT=6432
DB_NAME=society_events
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_POOL_SIZE=5

# Novu Configuration
NOVU_API_KEY=your_novu_api_key
NOVU_BACKEND_URL=https://api.novu.co
NOVU_STRATEGY=NOVU_WITH_FALLBACK

# Fallback Channels (Legacy)
AUTH_SERVICE_URL=http://host.containers.internal:8000
AUTH_SERVICE_API_KEY=your_auth_service_api_key

# Email (Gmail SMTP)
GMAIL_SMTP_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Splunk Logging
SPLUNK_HEC_URL=http://host.containers.internal:8088/services/collector/event
SPLUNK_HEC_TOKEN=your_splunk_token

# Society Configuration
SOCIETY_ID=11100000-0000-0000-0000-000000000001

# Keycloak
KEYCLOAK_URL=https://auth.gm-global-techies-town.club
KEYCLOAK_REALM=society-events
KEYCLOAK_PUBLIC_URL=https://auth.gm-global-techies-town.club

# Internal Service Communication
INTERNAL_API_KEY=your_internal_api_key
USER_SERVICE_URL=http://user-service:3001

# Async Processing
USE_BACKGROUND_TASKS=true

# Optional Notification Service Configuration
ENABLE_NOTIFICATIONS=true
NOTIFICATION_QUEUE_TYPE=redis

# Redis Configuration (for notification queue)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Notification Channels Configuration
NOTIFICATION_CHANNELS=email,novu
EMAIL_ENABLED=true
SMS_ENABLED=false
TELEGRAM_ENABLED=false

# SMS Provider Configuration (twilio or aws-sns)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Retry Configuration
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_BACKOFF_SECONDS=60
