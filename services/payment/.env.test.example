COMPOSE_PROJECT_NAME=society-test

# ─── Shared platform (must match the values the root .env* was started with) ──
POSTGRES_DB=society_events_test

# ─── payment-service's own DB role — see DB_ISOLATION_PLAN.md ──
PAYMENT_DB_USER=payment_role
PAYMENT_DB_PASSWORD=your_payment_db_password

# ─── Keycloak ─────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://host.docker.internal:8180
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# ─── Inter-service auth ───────────────────────────────────────────────────
INTERNAL_API_KEY=your_internal_api_key

# ─── Service-specific ─────────────────────────────────────────────────────
APP_PUBLIC_URL=your_app_public_url
PAYMENT_SECRET_KEY=your_payment_secret_key
SPLUNK_HEC_TOKEN=
AUTH_SERVICE_API_KEY=
PAYMENT_RECONCILIATION_SECRET_KEY=
ANTHROPIC_API_KEY=
GMAIL_SMTP_USER=your_gmail_smtp_user
GMAIL_APP_PASSWORD=your_gmail_app_password

# ─── MinIO (shared object storage — must match the root stack's values) ──
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
