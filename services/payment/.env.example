# ─── Payment Service Configuration (.env.example template) ───────────────────
COMPOSE_PROJECT_NAME=society

# ─── Database Access (schema isolation — see DB_ISOLATION_PLAN.md) ────────────
PAYMENT_DB_USER=payment_role
PAYMENT_DB_PASSWORD=your_payment_db_password
POSTGRES_HOST=society_postgres
POSTGRES_PORT=5432
POSTGRES_DB=society_events

# ─── Authentication (Keycloak JWT validation) ────────────────────────────────
KEYCLOAK_URL=https://auth.gm-global-techies-town.club
KEYCLOAK_PUBLIC_URL=https://auth.gm-global-techies-town.club

# ─── Inter-service Communication ───────────────────────────────────────────────
INTERNAL_API_KEY=your_internal_api_key
NOTIFICATION_SERVICE_URL=http://notification-service:3009

# ─── Payment Service Encryption ────────────────────────────────────────────────
# Encrypts per-event IMAP passwords at rest (committee_registry)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_SECRET_KEY=your_fernet_payment_secret_key

# ─── Payment Reconciliation (shared with ~/payment_reconcilation_service) ──────
# Must match PAYMENT_RECONCILIATION_SECRET_KEY in root .env
PAYMENT_RECONCILIATION_SECRET_KEY=your_payment_reconciliation_secret_key

# ─── Environment Mode ────────────────────────────────────────────────────────
# "testing" mounts /api/payments/test/* (clear-transactions, seed-transaction)
PAYMENT_SERVICE_ENV=testing

# ─── AI Provider for IMAP Parsing (choose: claude or ollama) ─────────────────
# Change via PUT /settings on the payment service endpoint
CLAUDE_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Auth Service Integration ─────────────────────────────────────────────────
AUTH_SERVICE_API_KEY=your_auth_service_api_key

# ─── Society Configuration ────────────────────────────────────────────────────
SOCIETY_NAME=your_society_name
SOCIETY_SHORT_NAME=your_society_short_name
SOCIETY_CITY=your_society_city
APP_PUBLIC_URL=your_app_public_url

# ─── Email (Gmail SMTP for IMAP polling) ──────────────────────────────────────
GMAIL_SMTP_USER=your_gmail_smtp_user
GMAIL_APP_PASSWORD=your_gmail_app_password

# ─── MinIO (object storage) ────────────────────────────────────────────────────
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password

# ─── Monitoring ───────────────────────────────────────────────────────────────
SPLUNK_HEC_TOKEN=your_splunk_hec_token
