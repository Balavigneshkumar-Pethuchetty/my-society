# ─── User Service Configuration (.env.example template) ───────────────────────
COMPOSE_PROJECT_NAME=society

# ─── Database Access (schema isolation — see DB_ISOLATION_PLAN.md) ────────────
USER_DB_USER=user_role
USER_DB_PASSWORD=your_user_db_password
POSTGRES_HOST=society_postgres
POSTGRES_PORT=5432
POSTGRES_DB=society_events

# ─── PII Encryption at Rest ───────────────────────────────────────────────────
# Encrypts sensitive fields: users.phone, users.email (see PII_PRIVACY_PLAN.md)
# Generate new keys with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
PII_ENCRYPTION_KEY=your_fernet_encryption_key
PII_HASH_KEY=your_long_random_hash_key

# ─── Authentication (Keycloak JWT validation) ────────────────────────────────
KEYCLOAK_URL=https://auth.gm-global-techies-town.club
KEYCLOAK_PUBLIC_URL=https://auth.gm-global-techies-town.club

# ─── Inter-service Communication ───────────────────────────────────────────────
INTERNAL_API_KEY=your_internal_api_key
NOTIFICATION_SERVICE_URL=http://notification-service:3009

# ─── Auth Service Integration ─────────────────────────────────────────────────
AUTH_SERVICE_API_KEY=your_auth_service_api_key
OTP_BRIDGE_CLIENT_ID=otp-bridge
OTP_BRIDGE_CLIENT_SECRET=your_otp_bridge_client_secret

# ─── MinIO (object storage) ────────────────────────────────────────────────────
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password

# ─── Society Configuration ────────────────────────────────────────────────────
SOCIETY_NAME=your_society_name
SOCIETY_SHORT_NAME=your_society_short_name
SOCIETY_CITY=your_society_city
APP_PUBLIC_URL=your_app_public_url

# ─── Email (Gmail SMTP — managed by Keycloak/notification-service) ────────────
GMAIL_SMTP_USER=your_gmail_smtp_user
GMAIL_APP_PASSWORD=your_gmail_app_password

# ─── Monitoring ───────────────────────────────────────────────────────────────
SPLUNK_HEC_TOKEN=your_splunk_hec_token

# ─── Optional Notification Service (with Graceful Degradation) ─────────────────
ENABLE_NOTIFICATIONS=true
NOTIFICATION_QUEUE_TYPE=redis
