# ─── Root .env.example: Shared/Global Configuration ─────────────────────────
# Copy this file to .env and fill in your values
# This file contains variables shared across all services.
# Service-specific variables should be in their respective .env files (nginx/.env, services/*/env, etc.)

# ─── Project Identity ──────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=society
SOCIETY_NAME=your_society_name
SOCIETY_SHORT_NAME=your_society_short_name
SOCIETY_CITY=your_city

# ─── Global URLs ──────────────────────────────────────────────────────────────
APP_PUBLIC_URL=https://your-domain.com
KEYCLOAK_URL=https://auth.your-domain.com
KEYCLOAK_PUBLIC_URL=https://auth.your-domain.com

# ─── Inter-service Authentication ─────────────────────────────────────────────
INTERNAL_API_KEY=your_internal_api_key

# ─── Keycloak (managed in ~/auth-service) ─────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password
KEYCLOAK_DB=keycloak
KEYCLOAK_API_CLIENT_SECRET=your_keycloak_api_client_secret

# ─── Google OAuth 2.0 (Social login) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── OTP Login (via ~/auth-service) ────────────────────────────────────────────
OTP_BRIDGE_CLIENT_ID=otp-bridge
OTP_BRIDGE_CLIENT_SECRET=your_otp_bridge_client_secret
AUTH_SERVICE_API_KEY=your_auth_service_api_key

# ─── MinIO (object storage) ────────────────────────────────────────────────────
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_CONSOLE_PORT=9091

# ─── Splunk Monitoring (optional profile) ─────────────────────────────────────
SPLUNK_PASSWORD=your_splunk_password
SPLUNK_HEC_TOKEN=your_splunk_hec_token
SPLUNK_PORT=8000

# ─── Payment Reconciliation Secret (shared with ~/payment_reconcilation_service) ─
PAYMENT_RECONCILIATION_SECRET_KEY=your_payment_reconciliation_secret_key
