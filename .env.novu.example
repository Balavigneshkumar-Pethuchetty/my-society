# Novu Configuration
# Copy this to .env and fill in the actual values

# API key from Novu dashboard (create at http://localhost:3000/settings/api-keys)
NOVU_API_KEY=your_novu_api_key_here

# Novu base URL (internal Docker network)
NOVU_BASE_URL=http://novu-api:3000

# Novu JWT Secret (for signing tokens - use any strong string)
NOVU_JWT_SECRET=your-jwt-secret-key-minimum-32-characters

# Novu Encryption Key (for encrypting sensitive data)
NOVU_ENCRYPTION_KEY=your-encryption-key-minimum-32-characters

# Channel Configuration

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# SMS Provider (choose one)
# Options: twilio, sns, custom
SMS_PROVIDER=twilio

# Twilio Configuration (if using Twilio)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AWS SNS Configuration (if using SNS)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@society-events.com
