# ─── Nginx Configuration (.env.example template) ───────────────────────────────
# Reverse proxy and static file server

# ─── Port ─────────────────────────────────────────────────────────────────────
NGINX_PORT=8080

# ─── Basic Authentication for Admin Access ────────────────────────────────────
NGINX_ADMIN_USER=admin
NGINX_ADMIN_PASSWORD=your_nginx_admin_password

# ─── pgAdmin Access (proxied through nginx) ───────────────────────────────────
PGADMIN_EMAIL=your_email@example.com
PGADMIN_PASSWORD=your_pgadmin_password
PGADMIN_PORT=5050
