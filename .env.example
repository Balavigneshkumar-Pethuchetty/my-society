# Copy this file and fill in your values:  cp .env.example .env

# ─── Nginx (reverse proxy — single public entry point) ───────────────────────
# All services are routed through port 80. Admin tools (/pgadmin, /splunk) are
# protected by HTTP Basic Auth using these credentials.
NGINX_PORT=80
NGINX_ADMIN_USER=admin
NGINX_ADMIN_PASSWORD=your_nginx_admin_password

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Shared by application services. Keycloak now uses its own DB in auth-service.
# Bound to 127.0.0.1 — accessible from the host for psql/pgAdmin desktop clients.
POSTGRES_USER=society_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5432

# ─── Event Service — own DB role (schema isolation, see DB_ISOLATION_PLAN.md) ─
# After applying db/migrations/033_event_service_schema_isolation.sql, rotate
# event_role's placeholder password to this value:
#   ALTER ROLE event_role PASSWORD '<this>';
EVENT_DB_USER=event_role
EVENT_DB_PASSWORD=your_event_role_password
TICKET_DB_USER=ticket_role
TICKET_DB_PASSWORD=your_ticket_role_password
USER_DB_USER=user_role
USER_DB_PASSWORD=your_user_role_password
PAYMENT_DB_USER=payment_role
PAYMENT_DB_PASSWORD=your_payment_role_password
REGISTRATION_DB_USER=registration_role
REGISTRATION_DB_PASSWORD=your_registration_role_password

# ─── Visitor Service — dedicated Postgres (own container, own volume) ────────
# Deliberately separate from the `postgres` container above — visitor-service
# is meant to run as a genuinely independent service (see services/visitor).
# No host port — reached only via the compose network (visitor-postgres:5432).
# Visitor phone verification reuses AUTH_SERVICE_URL/AUTH_SERVICE_API_KEY below,
# no separate secret needed.
VISITOR_POSTGRES_USER=visitor_service
VISITOR_POSTGRES_PASSWORD=your_visitor_postgres_password
VISITOR_POSTGRES_DB=visitor_service

# ─── Keycloak (centralized auth-service at ~/auth-service) ───────────────────
# Keycloak is hosted by the centralized auth-service and exposed publicly at
# https://auth.gm-global-techies-town.club via its Cloudflare tunnel.
# KEYCLOAK_URL  — backend service-to-service URL (can use the public HTTPS URL)
# KEYCLOAK_PUBLIC_URL — browser-facing URL (same as KEYCLOAK_URL for centralized setup)
# KEYCLOAK_ADMIN_USER / PASSWORD — master-realm admin credentials from auth-service .env
KEYCLOAK_URL=https://auth.gm-global-techies-town.club
KEYCLOAK_PUBLIC_URL=https://auth.gm-global-techies-town.club
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password
KEYCLOAK_API_CLIENT_SECRET=your_keycloak_api_client_secret_min_32_chars

# ─── App public URL ───────────────────────────────────────────────────────────
# Used by user-service, registration-service, and payment-service to build
# clickable deep links inside SMS/Telegram/email notification messages
# (e.g. straight to the admin review page for a specific request/payment/refund).
APP_PUBLIC_URL=https://gm-global-techies-town.club

# ─── Google OAuth — OPTIONAL (Social Login via Keycloak) ─────────────────────
# Configure in the auth-service Keycloak admin UI (https://auth.gm-global-techies-town.club/admin).
# Authorised redirect URI: https://auth.gm-global-techies-town.club/realms/society-events/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── pgAdmin 4 (Database GUI — served at /pgadmin/) ──────────────────────────
# Has NO host port — accessed through nginx (nginx basic auth required first).
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password

# ─── Redis ────────────────────────────────────────────────────────────────────
# Bound to 127.0.0.1 only — accessible from the host for debugging but not publicly exposed.
# REDIS_PASSWORD is optional: leave blank to run Redis without authentication (local dev only).
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

# ─── MinIO (S3-compatible object storage for avatars/screenshots/photos) ─────
# Console (port 9001) is bound to 127.0.0.1 only, for host-side debugging via
# browser or `mc`. The S3 API (port 9000) has no host port — reached only via
# the compose network (minio:9000), proxied publicly through nginx at
# /api/<service>/uploads/*.
MINIO_ROOT_USER=your_minio_root_user
MINIO_ROOT_PASSWORD=your_minio_root_password_min_8_chars
MINIO_CONSOLE_PORT=9001

# ─── Application Services ─────────────────────────────────────────────────────
# Shared secret for internal service-to-service calls. Use a long random string.
INTERNAL_API_KEY=your_internal_api_key_min_32_chars

# ─── Society Configuration ────────────────────────────────────────────────────
SOCIETY_NAME=Your Society Name
SOCIETY_SHORT_NAME=YSN
SOCIETY_CITY=Your City

# ─── Gmail SMTP — OPTIONAL (Keycloak outbound email) ─────────────────────────
# Configure SMTP in the auth-service Keycloak admin UI, or run: make setup-email
# which calls the Keycloak Admin API at KEYCLOAK_URL.
# Generate an App Password at https://myaccount.google.com/apppasswords (2FA required).
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=

# ─── PII encryption at rest — user-service only (users.phone/users.email) ────
# See PII_PRIVACY_PLAN.md. PII_ENCRYPTION_KEY must be base64 for exactly 32
# raw bytes (AES-256-GCM); generate with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# PII_HASH_KEY is any long random secret string (HMAC-SHA256 blind index) and
# must be a DIFFERENT value from PII_ENCRYPTION_KEY. Both required — user-service
# won't start without them once this migration has been applied.
PII_ENCRYPTION_KEY=
PII_HASH_KEY=

# ─── Splunk — OPTIONAL (centralized ~/splunk-service) ────────────────────────
# Splunk runs as a separate centralized service — start it with: make splunk-up
# Web UI: https://splunk.gm-global-techies-town.club
# HEC endpoint (services ship events here): http://localhost:8088
#
# SPLUNK_HEC_TOKEN — shared token used by all services and Fluent Bit to ship
#   events to the HEC at host.containers.internal:8088. Leave blank to disable
#   all log shipping (services remain fully functional without Splunk).
# Copy the token value from ~/splunk-service/.env (SPLUNK_HEC_TOKEN).
SPLUNK_HEC_TOKEN=

# ─── Claude API (Anthropic) — OPTIONAL ────────────────────────────────────────
# Used by the payment service's IMAP email parser as an alternative to Ollama.
# Select it per-deployment via ai_provider="claude" in PUT /settings (payment
# service) — this key only takes effect when that setting is chosen. Leave
# blank to use Ollama/regex only.
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Payment service test mode — OPTIONAL ─────────────────────────────────────
# "testing" mounts extra /api/payments/test/* endpoints (clear-transactions,
# seed-transaction) used to exercise the centralized reconciliation service's
# /parseEmail without a real checkout. Leave as "production" everywhere else —
# these endpoints must never be reachable in a real deployment.
PAYMENT_SERVICE_ENV=production

# ─── Payment service — encrypts per-event IMAP passwords at rest (committee_registry) ──
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_SECRET_KEY=

# ─── Frontend build mode ─────────────────────────────────────────────────────
# Controls which Vite build mode is used and whether debug panels are shown.
# dev/test: token debug panel visible. stage/prod: hidden.
VITE_MODE=production
VITE_APP_ENV=prod

# ─── Phone verification (via ~/auth-service's turnkey OTP API) ────────────────
# user-service calls POST {AUTH_SERVICE_URL}/api/otp/request and /verify to
# send/check phone-verification codes — auth-service owns OTP generation,
# storage, and SMS delivery; this repo only calls it.
# AUTH_SERVICE_URL defaults to http://host.containers.internal:8000 — override
# only if auth-service's backend moves host/port.
# Must match auth-service's OTP_SERVICE_API_KEY (~/auth-service/.env).
AUTH_SERVICE_API_KEY=

# ─── Phone-OTP login (already-registered, already phone-verified users only) ──
# otp-bridge Keycloak service account — RFC 8693 token exchange to mint a real
# access token for a phone-OTP-verified user without touching their password.
# Client already provisioned on ~/auth-service's Keycloak (realm
# society-events); fetch the secret via the admin API or console if rotated.
OTP_BRIDGE_CLIENT_ID=otp-bridge
OTP_BRIDGE_CLIENT_SECRET=
# Frontend toggle for the "Sign in with Phone" entry point on Landing.
VITE_PHONE_LOGIN=true

# ─── Novu Notification Orchestration ──────────────────────────────────────────
# Centralized notification service for SMS, Email, Telegram, and in-app notifications.
# Strategy:
#   - "novu_only": Use Novu exclusively (no fallback to legacy system)
#   - "legacy_only": Use legacy auth-service + SMTP (ignore Novu)
#   - "novu_with_fallback": Try Novu first, fall back to legacy if unavailable (default)
NOVU_API_KEY=
NOVU_JWT_SECRET=your-jwt-secret-change-in-production
NOVU_ENCRYPTION_KEY=your-encryption-key-change-in-production
NOTIFICATION_STRATEGY=novu_with_fallback
