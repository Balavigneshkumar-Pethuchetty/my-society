# ─── Frontend Configuration (.env.example template) ──────────────────────────
# Shared configuration for all frontend micro-frontends (MFEs)

# ─── Build Mode ────────────────────────────────────────────────────────────────
VITE_MODE=production
VITE_APP_ENV=prod

# ─── Social Login Features ────────────────────────────────────────────────────
VITE_GOOGLE_LOGIN=true
VITE_PHONE_LOGIN=true

# ─── Public URLs (shared across all MFEs) ─────────────────────────────────────
VITE_KEYCLOAK_URL=https://auth.your-domain.com
VITE_APP_PUBLIC_URL=https://your-domain.com
