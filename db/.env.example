# ─── Database Configuration (.env.example template) ───────────────────────────
# PostgreSQL (main shared database) and Redis (cache)

# ─── PostgreSQL Main Database ─────────────────────────────────────────────────
POSTGRES_USER=society_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5432
POSTGRES_DB=society_events

# ─── Database Roles per Service (schema isolation) ───────────────────────────
# After applying db/migrations/033_event_service_schema_isolation.sql, rotate
# each role's placeholder password to these values:
#   ALTER ROLE <role_name> PASSWORD '<password>';

# Event Service
EVENT_DB_USER=event_role
EVENT_DB_PASSWORD=your_event_db_password

# Ticket Service
TICKET_DB_USER=ticket_role
TICKET_DB_PASSWORD=your_ticket_db_password

# User Service
USER_DB_USER=user_role
USER_DB_PASSWORD=your_user_db_password

# Payment Service
PAYMENT_DB_USER=payment_role
PAYMENT_DB_PASSWORD=your_payment_db_password

# Registration Service
REGISTRATION_DB_USER=registration_role
REGISTRATION_DB_PASSWORD=your_registration_db_password

# ─── Visitor Service — Dedicated PostgreSQL Instance ────────────────────────
# This service has its own Postgres container and database
VISITOR_POSTGRES_USER=visitor_service
VISITOR_POSTGRES_PASSWORD=your_visitor_postgres_password
VISITOR_POSTGRES_DB=visitor_service

# ─── Redis Cache ──────────────────────────────────────────────────────────────
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379
